---
interface Props {
  seed?: number;
  secondarySeed?: number;
  size?: number;
  position1?: Vec2;
  position2?: Vec2;
  width?: number;
  height?: number;
  baseRadius?: number;
  points?: number;
  wobble?: number;
  wobbleAmplitude?: number;
  fillColor?: string;
  bandColors?: string[];
}

const seed = Astro.props.seed ?? 777;
const secondarySeed = Astro.props.secondarySeed ?? seed + 1;
const size = Astro.props.size ?? 400;
const position1 = Astro.props.position1 ?? { x: 0, y: 1 };
const position2 = Astro.props.position2 ?? { x: 1, y: 0 };
const width = Astro.props.width ?? 1200;
const height = Astro.props.height ?? 650;
const baseRadius = Astro.props.baseRadius ?? 200;
const points = Astro.props.points ?? 12;
const wobble = Astro.props.wobble ?? 1;
const wobbleAmplitude = Astro.props.wobbleAmplitude ?? 0.1;

// Default color is indigo-500 from tailwindcss.
const fillColor = Astro.props.fillColor ?? "#6366f1";
const bandColors = Astro.props.bandColors ?? [
  "#ffffff16",
  "#ffffff16",
  "#ffffff16",
  "#ffffff16",
];

/* ------------------------------------------------------------------ */
/* Types                                                              */
/* ------------------------------------------------------------------ */

type RNG = () => number;

type Vec2 = { x: number; y: number };

interface RingCornerConfig {
  position: Vec2;
  baseRadius: number;
  size: number;
  bands: number;
  points: number;
  wobble: number; // 0..1, how irregular the circle is
  wobbleAmplitude: number; // 0..something, radius factor
  seed: number;
}

interface PolarNoiseField {
  center: Vec2;
  baseRadius: number;
  bandThickness: number;
  angles: number[];
  offsets: number[]; // per-angle radial noise in [-wobbleAmplitude, +wobbleAmplitude]
}

/* ------------------------------------------------------------------ */
/* Deterministic RNG                                                   */
/* ------------------------------------------------------------------ */

function mulberry32(seed: number): RNG {
  let t: number = seed >>> 0;
  return (): number => {
    t += 0x6d2b79f5;
    let x: number = Math.imul(t ^ (t >>> 15), 1 | t);
    x ^= x + Math.imul(x ^ (x >>> 7), 61 | x);
    return ((x ^ (x >>> 14)) >>> 0) / 4294967296;
  };
}

/* ------------------------------------------------------------------ */
/* Catmull–Rom → cubic Bézier                                          */
/* ------------------------------------------------------------------ */

function catmullRomClosedToBezierPath(
  points: Vec2[],
  tension: number = 1
): string {
  if (points.length < 3) return "";
  const n: number = points.length;

  const c = (i: number): Vec2 => points[(i + n) % n];

  let d: string = `M ${points[0].x.toFixed(2)} ${points[0].y.toFixed(2)} `;

  for (let i: number = 0; i < n; i++) {
    const p0: Vec2 = c(i - 1);
    const p1: Vec2 = c(i);
    const p2: Vec2 = c(i + 1);
    const p3: Vec2 = c(i + 2);

    const t: number = tension;

    const cp1x: number = p1.x + ((p2.x - p0.x) / 6) * t;
    const cp1y: number = p1.y + ((p2.y - p0.y) / 6) * t;

    const cp2x: number = p2.x - ((p3.x - p1.x) / 6) * t;
    const cp2y: number = p2.y - ((p3.y - p1.y) / 6) * t;

    d += `C ${cp1x.toFixed(2)} ${cp1y.toFixed(2)}, ${cp2x.toFixed(
      2
    )} ${cp2y.toFixed(2)}, ${p2.x.toFixed(2)} ${p2.y.toFixed(2)} `;
  }

  return d + "Z";
}

/* ------------------------------------------------------------------ */
/* Polar noise field: one imperfect circle per corner                  */
/* ------------------------------------------------------------------ */

function createPolarNoiseField(
  cfg: RingCornerConfig,
  width: number,
  height: number
): PolarNoiseField {
  const center: Vec2 = {
    x: width * cfg.position.x,
    y: height * cfg.position.y,
  };

  const rand: RNG = mulberry32(cfg.seed);
  const angles: number[] = [];
  const offsets: number[] = [];

  const twoPi: number = Math.PI * 2;
  const step: number = twoPi / cfg.points;

  for (let i: number = 0; i < cfg.points; i++) {
    const baseAngle: number = i * step;

    // Slight angle jitter to avoid too-regular slices
    const jitter: number = (rand() - 0.5) * step * 0.35 * cfg.wobble;
    const angle: number = baseAngle + jitter;

    // Radial noise in [-wobbleAmplitude, +wobbleAmplitude] (relative factor)
    const noiseFactor: number = (rand() - 0.5) * 2 * cfg.wobbleAmplitude;

    angles.push(angle);
    offsets.push(noiseFactor);
  }

  return {
    center,
    baseRadius: cfg.baseRadius,
    bandThickness: cfg.size / cfg.bands,
    angles,
    offsets,
  };
}

/* ------------------------------------------------------------------ */
/* Build a single band from a shared noise field                       */
/* ------------------------------------------------------------------ */

function generateNoisyCirclePath(
  field: PolarNoiseField,
  layerIndex: number,
  tension: number = 1
): string {
  const { center, baseRadius, bandThickness, angles, offsets } = field;

  const radius: number = baseRadius + layerIndex * bandThickness;
  const points: { x: number; y: number }[] = [];

  for (let i: number = 0; i < angles.length; i++) {
    const angle: number = angles[i];
    const noiseFactor: number = offsets[i];

    const r: number = radius * (1 + noiseFactor);

    const cosA: number = Math.cos(angle);
    const sinA: number = Math.sin(angle);

    points.push({
      x: center.x + cosA * r,
      y: center.y + sinA * r,
    });
  }

  return catmullRomClosedToBezierPath(points, tension);
}

/* ------------------------------------------------------------------ */
/* Scene setup                                                         */
/* ------------------------------------------------------------------ */

const backgroundColor: string = fillColor;

const corners: RingCornerConfig[] = [
  {
    position: position1,
    baseRadius,
    size,
    bands: bandColors.length,
    points,
    wobble,
    wobbleAmplitude,
    seed: seed,
  },
  {
    position: position2,
    baseRadius,
    size,
    bands: bandColors.length,
    points,
    wobble,
    wobbleAmplitude,
    seed: secondarySeed,
  },
];

const polarFields: PolarNoiseField[] = corners.map((cfg: RingCornerConfig) =>
  createPolarNoiseField(cfg, width, height)
);

const ringLayers = polarFields.map(
  (field: PolarNoiseField, cornerIndex: number) => {
    return Array.from(
      { length: bandColors.length },
      (_: unknown, bandIndex: number) => {
        const d: string = generateNoisyCirclePath(field, bandIndex, 1);
        const fill: string = bandColors[bandIndex];

        return {
          d,
          fill,
          key: `${cornerIndex}-${bandIndex}`,
        };
      }
    );
  }
);
---

<div style="z-index: -10; position: absolute; inset: 0; pointer-events: none;">
  <svg
    viewBox={`0 0 ${width} ${height}`}
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
    style="width: 100%; height: 100%"
  >
    <rect x="0" y="0" width={width} height={height} fill={backgroundColor}
    ></rect>

    {
      ringLayers.map((bands) =>
        bands
          .slice()
          .reverse()
          .map((band) => <path d={band.d} fill={band.fill} />)
      )
    }
  </svg>
</div>
